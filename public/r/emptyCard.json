{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "emptyCard",
  "type": "registry:component",
  "description": "Pihanga emptyCard card component — an empty-state placeholder with an optional icon and a Pihanga card content slot.",
  "dependencies": [
    "class-variance-authority"
  ],
  "registryDependencies": [
    "https://ivcap-works.github.io/pihanga-shadcn/r/pihanga-base.json",
    "https://ivcap-works.github.io/pihanga-shadcn/r/pihanga-cards-icons.json"
  ],
  "files": [
    {
      "path": "components/ui/empty.tsx",
      "type": "registry:ui",
      "target": "src/components/ui/empty.tsx"
    },
    {
      "path": "cards/emptyCard/emptyCard.types.ts",
      "type": "registry:component",
      "target": "src/cards/emptyCard/emptyCard.types.ts"
    },
    {
      "path": "cards/emptyCard/emptyCard.component.tsx",
      "type": "registry:component",
      "target": "src/cards/emptyCard/emptyCard.component.tsx"
    },
    {
      "path": "cards/emptyCard/index.tsx",
      "type": "registry:component",
      "target": "src/cards/emptyCard/index.tsx"
    }
  ]
}